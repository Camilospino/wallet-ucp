# Root environment overrides for docker compose.
# Copy this file to `.env` and adjust as needed. All values are optional.

# Host port where PostgreSQL is published.
DB_PORT=5432

# Host port where the backend is published.
# NOTE: macOS AirPlay Receiver often occupies port 5000. If the backend fails
# to start with "address already in use", set this to 5001 and update
# VITE_API_URL below to match.
BACKEND_PORT=5000

# Host port where the frontend (Vite) is published.
FRONTEND_PORT=3000

# URL the browser uses to reach the backend. Must match BACKEND_PORT.
VITE_API_URL=http://localhost:5000

# Origin allowed by CORS on the backend. Must match FRONTEND_PORT.
CORS_ORIGIN=http://localhost:3000

# Change this in any non-local environment.
JWT_SECRET=dev-secret-key-change-in-production