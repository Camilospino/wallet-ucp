# Copiar a .env (dentro del laboratorio: /opt/wallet/docker/.env).
# Contrasena del superusuario `postgres` del contenedor de base de datos.
POSTGRES_PASSWORD=cambia-esta-clave
# Contrasena del rol `walletucp` con el que se conectan los backends. Debe
# coincidir con la que aparece en DATABASE_URL de env/produccion.env y env/qa.env.
WALLET_DB_PASSWORD=walletucp_password
