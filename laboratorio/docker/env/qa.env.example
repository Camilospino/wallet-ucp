# Backend de QA (rama develop). Copiar a qa.env. Usa OTRA base y OTRO secreto.
PORT=5001
DATABASE_URL=postgresql://walletucp:walletucp_password@postgres:5432/walletucp_qa
JWT_SECRET=cambia-este-secreto-de-qa
JWT_EXPIRES_IN=24h
BCRYPT_ROUNDS=10
NODE_ENV=production
CORS_ORIGIN=http://wallet-ucp-qa.local:8080
RATE_LIMIT_AUTH_MAX=20
RATE_LIMIT_FINANCIAL_MAX=30
RATE_LIMIT_GENERAL_MAX=1000
