{
  "info": {
    "name": "WalletUCP API",
    "description": "Importa esta coleccion y ejecuta primero la carpeta 1. Autenticacion: el token se guarda solo.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:5001",
      "type": "string"
    },
    {
      "key": "userToken",
      "value": "",
      "type": "string"
    },
    {
      "key": "adminToken",
      "value": "",
      "type": "string"
    },
    {
      "key": "creditCardId",
      "value": "",
      "type": "string"
    },
    {
      "key": "debitCardId",
      "value": "",
      "type": "string"
    },
    {
      "key": "foreignCardId",
      "value": "",
      "type": "string"
    },
    {
      "key": "creditSaldo",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "0. Sin autenticacion",
      "item": [
        {
          "name": "Health check",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/health"
          }
        },
        {
          "name": "Raiz - info del servidor",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/"
          }
        }
      ]
    },
    {
      "name": "1. Autenticacion",
      "item": [
        {
          "name": "Login ADMIN (guarda token)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@example.com\",\n  \"password\": \"Admin123!\"\n}"
            },
            "url": "{{baseUrl}}/api/auth/login"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const body = pm.response.json();",
                  "pm.test(\"Login exitoso\", () => pm.expect(body.success).to.eql(true));",
                  "pm.test(\"Rol correcto\", () => pm.expect(body.data.user.rol).to.eql(\"ADMIN\"));",
                  "pm.collectionVariables.set(\"adminToken\", body.data.token);"
                ]
              }
            }
          ]
        },
        {
          "name": "Login USER1 (guarda token)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"user1@example.com\",\n  \"password\": \"User123!\"\n}"
            },
            "url": "{{baseUrl}}/api/auth/login"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const body = pm.response.json();",
                  "pm.test(\"Login exitoso\", () => pm.expect(body.success).to.eql(true));",
                  "pm.test(\"Rol correcto\", () => pm.expect(body.data.user.rol).to.eql(\"USER\"));",
                  "pm.collectionVariables.set(\"userToken\", body.data.token);"
                ]
              }
            }
          ]
        },
        {
          "name": "Perfil (GET /auth/me)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{userToken}}"
              }
            ],
            "url": "{{baseUrl}}/api/auth/me"
          }
        },
        {
          "name": "Password incorrecta (espera 401)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"user1@example.com\",\n  \"password\": \"claveIncorrecta\"\n}"
            },
            "url": "{{baseUrl}}/api/auth/login"
          }
        },
        {
          "name": "Registro de usuario nuevo",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nombre\": \"Ana\",\n  \"apellido\": \"Restrepo\",\n  \"email\": \"ana.test@example.com\",\n  \"password\": \"Password123!\",\n  \"telefono\": \"+573001234567\"\n}"
            },
            "url": "{{baseUrl}}/api/auth/register"
          }
        },
        {
          "name": "Registro duplicado (espera 409)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nombre\": \"Otro\",\n  \"apellido\": \"Dup\",\n  \"email\": \"user1@example.com\",\n  \"password\": \"Password123!\"\n}"
            },
            "url": "{{baseUrl}}/api/auth/register"
          }
        }
      ]
    },
    {
      "name": "2. Billetera",
      "item": [
        {
          "name": "Ver mi billetera",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{userToken}}"
              }
            ],
            "url": "{{baseUrl}}/api/wallet"
          }
        },
        {
          "name": "Depositar 10000",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{userToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"amount\": 10000\n}"
            },
            "url": "{{baseUrl}}/api/wallets/deposit"
          }
        },
        {
          "name": "Retirar 5000",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{userToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"amount\": 5000\n}"
            },
            "url": "{{baseUrl}}/api/wallets/withdraw"
          }
        },
        {
          "name": "Retiro sin saldo (espera 400)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{userToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"amount\": 99999999\n}"
            },
            "url": "{{baseUrl}}/api/wallets/withdraw"
          }
        },
        {
          "name": "Depositar 0 - VALIDACION (espera 422)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{userToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"amount\": 0\n}"
            },
            "url": "{{baseUrl}}/api/wallets/deposit"
          }
        },
        {
          "name": "Depositar texto - VALIDACION (espera 422)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{userToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"amount\": \"abc\"\n}"
            },
            "url": "{{baseUrl}}/api/wallets/deposit"
          }
        }
      ]
    },
    {
      "name": "2b. Tarjetas (credito y debito con saldo propio)",
      "item": [
        {
          "name": "Ver tarjetas de ADMIN (guarda una ajena)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{adminToken}}"
              }
            ],
            "url": "{{baseUrl}}/api/cards"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const body = pm.response.json();",
                  "pm.collectionVariables.set(\"foreignCardId\", body.data.cards[0].id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Ver mis tarjetas (guarda los ids)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{userToken}}"
              }
            ],
            "url": "{{baseUrl}}/api/cards"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const body = pm.response.json();",
                  "pm.test(\"Status 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"Exactamente 2 tarjetas\", () => pm.expect(body.data.cards).to.have.length(2));",
                  "const credit = body.data.cards.find((c) => c.tipo === \"CREDIT\");",
                  "const debit = body.data.cards.find((c) => c.tipo === \"DEBIT\");",
                  "pm.test(\"Una de credito y una de debito\", () => { pm.expect(credit).to.exist; pm.expect(debit).to.exist; });",
                  "pm.collectionVariables.set(\"creditCardId\", credit.id);",
                  "pm.collectionVariables.set(\"debitCardId\", debit.id);",
                  "pm.collectionVariables.set(\"creditSaldo\", credit.saldo);"
                ]
              }
            }
          ]
        },
        {
          "name": "Depositar 10000 en la tarjeta de credito",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{userToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/wallets/deposit",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"amount\": 10000,\n  \"cardId\": {{creditCardId}}\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const body = pm.response.json();",
                  "pm.test(\"Status 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"El dinero entra a la tarjeta de credito\", () => {",
                  "  pm.expect(body.data.card.tipo).to.eql(\"CREDIT\");",
                  "  pm.expect(body.data.card.saldo).to.eql(Number(pm.collectionVariables.get(\"creditSaldo\")) + 10000);",
                  "});",
                  "pm.collectionVariables.set(\"creditSaldo\", body.data.card.saldo);"
                ]
              }
            }
          ]
        },
        {
          "name": "Retirar de credito mas de su saldo (espera 400)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{userToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/wallets/withdraw",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"amount\": 999999999,\n  \"cardId\": {{creditCardId}}\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 400\", () => pm.response.to.have.status(400));",
                  "pm.test(\"Saldo insuficiente en la tarjeta\", () => pm.expect(pm.response.json().error).to.eql(\"INSUFFICIENT_BALANCE\"));"
                ]
              }
            }
          ]
        },
        {
          "name": "Transferir 1000 desde credito a la tarjeta de debito de user2",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{userToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/transfers",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"recipientEmail\": \"user2@example.com\",\n  \"amount\": 1000,\n  \"cardId\": {{creditCardId}},\n  \"recipientCardType\": \"DEBIT\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const body = pm.response.json();",
                  "pm.test(\"Status 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"Sale de la tarjeta de credito\", () => pm.expect(body.data.card.saldo).to.eql(Number(pm.collectionVariables.get(\"creditSaldo\")) - 1000));",
                  "pm.test(\"No expone la tarjeta del destinatario\", () => pm.expect(body.data.transaction).to.not.have.property(\"tarjeta_destino_id\"));"
                ]
              }
            }
          ]
        },
        {
          "name": "Usar la tarjeta de otro usuario (espera 404)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{userToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/wallets/deposit",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"amount\": 100,\n  \"cardId\": {{foreignCardId}}\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 404\", () => pm.response.to.have.status(404));",
                  "pm.test(\"CARD_NOT_FOUND\", () => pm.expect(pm.response.json().error).to.eql(\"CARD_NOT_FOUND\"));"
                ]
              }
            }
          ]
        },
        {
          "name": "Tipo de tarjeta destino invalido (espera 422)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{userToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/transfers",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"recipientEmail\": \"user2@example.com\",\n  \"amount\": 100,\n  \"recipientCardType\": \"PREPAGO\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 422\", () => pm.response.to.have.status(422));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
